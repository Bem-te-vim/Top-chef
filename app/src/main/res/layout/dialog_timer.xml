<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_top"
    android:backgroundTint="@color/background"
    android:padding="24dp">

    <View
        android:id="@+id/pickup_view"
        android:layout_width="40dp"
        android:layout_height="6dp"
        android:background="@drawable/rounded_square"
        android:backgroundTint="@color/myGray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_timer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/timer"
        android:textColor="@color/WhiteForTxt"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pickup_view" />

    <LinearLayout
        android:id="@+id/container_pickers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/txt_timer_title">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hour"
                android:textColor="@color/LtGrayFoTxt"
                android:textSize="16sp" />
            <NumberPicker
                android:id="@+id/picker_hours"
                android:layout_width="wrap_content"
                android:theme="@style/MyNumberPickerStyle"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MyNumberPickerStyle"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minutes"
                android:textColor="@color/LtGrayFoTxt"
                android:textSize="16sp" />
            <NumberPicker
                android:id="@+id/picker_minutes"
                android:layout_width="wrap_content"
                android:theme="@style/MyNumberPickerStyle"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seg"
                android:textColor="@color/LtGrayFoTxt"
                android:textSize="16sp" />
            <NumberPicker
                android:id="@+id/picker_seconds"
                android:layout_width="wrap_content"
                android:theme="@style/MyNumberPickerStyle"
                style="@style/MyNumberPickerStyle"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_timer_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-bold"
        android:text="00 : 00 : 00"
        android:textColor="@color/WhiteForTxt"
        android:textSize="48sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_timer_title"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="container_presets,txt_timer_display" />

    <LinearLayout
        android:id="@+id/container_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/container_pickers">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preset_10"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:backgroundTint="@color/backgroundIc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="10m"
            android:textColor="@color/default_color_app"
            android:textSize="12sp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.TopChef.Circle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preset_15"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/backgroundIc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="15m"
            android:textColor="@color/default_color_app"
            android:textSize="12sp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.TopChef.Circle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preset_30"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:backgroundTint="@color/backgroundIc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="30m"
            android:textColor="@color/default_color_app"
            android:textSize="12sp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.TopChef.Circle" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_start_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/rounded_square_shape"
        android:backgroundTint="@color/default_color_app"
        android:padding="12dp"
        android:text="@string/start"
        android:textColor="@color/WhiteForTxt"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/barrier" />

</androidx.constraintlayout.widget.ConstraintLayout>
