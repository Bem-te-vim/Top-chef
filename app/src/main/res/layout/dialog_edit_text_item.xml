<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:id="@+id/view_transition"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/rounded_square_shape"
        android:backgroundTint="@color/default_color_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Editar Item"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_transition" />

    <EditText
        android:id="@+id/edtx_edit_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_square_shape_for_edtx"
        android:backgroundTint="@color/backgroundIc"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="1"
        android:maxLines="5"
        android:padding="14dp"
        android:textColor="@color/white"
        android:textColorHint="@color/myGray"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/txt_dialog_title" />

    <Button
        android:id="@+id/btn_save_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/default_color_app"
        android:text="Salvar Alterações"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtx_edit_item" />

</androidx.constraintlayout.widget.ConstraintLayout>