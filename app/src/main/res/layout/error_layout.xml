<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_layout_root"
    android:background="@color/background2">

    <ImageView
        android:importantForAccessibility="no"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/error_24dp"
        app:tint="@color/myGray"/>

    <TextView
        android:id="@+id/error_title"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/myGray"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Olá!" />


    <TextView
        android:id="@+id/error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="50dp"
        android:layout_marginBottom="12dp"
        android:textAlignment="center"
        android:textColor="@color/myGray"
        android:textSize="14sp"
        tools:text="Parece que você ainda não tem nem uma receita salva." />

    <Button
        android:layout_marginHorizontal="80dp"
        android:id="@+id/btn_go_to_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Criar Receita"
        android:textColor="@color/WhiteForTxt"
        android:textSize="18sp"/>


</LinearLayout>
